# Public site URL used for canonical links, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://occasionfun.co.uk

# Optional external contact endpoint for static S3 hosting (otherwise mailto fallback)
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Destination mailbox for enquiry notifications (server-side / reference API only)
CONTACT_NOTIFY_EMAIL=

# Optional webhook for the reference non-static API handler
CONTACT_WEBHOOK_URL=

# Set to "true" in CI/production builds to fail when unresolved [INSERT ...] placeholders remain
FAIL_ON_PLACEHOLDERS=false
