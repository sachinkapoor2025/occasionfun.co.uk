# Public site URL used for canonical links, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://occasionfun.co.uk

# Contact API URL. Next.js inlines this at build time. Leave it empty locally.
# The Amplify demo branch sets it in amplify.yml when the console variable is absent.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Demo administration. Leave these empty for a production build.
# The Amplify demo branch receives the Demo pool and Admin API from
# scripts/amplify-public-env.mjs. Copy those public Demo values into
# .env.local for a local Demo build. Do not put Production values here.
NEXT_PUBLIC_COGNITO_REGION=
NEXT_PUBLIC_COGNITO_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_ADMIN_API_BASE=

# Destination mailbox for enquiry notifications (server-side / reference API only)
CONTACT_NOTIFY_EMAIL=

# Optional webhook for the reference non-static API handler
CONTACT_WEBHOOK_URL=

# Set to "true" in CI/production builds to fail when unresolved [INSERT ...] placeholders remain
FAIL_ON_PLACEHOLDERS=false
