{
  "name": "occasionfun-co-uk-contact",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "OccasionFun.co.uk contact API. API Gateway, Lambda, DynamoDB and cPanel SMTP. No SES.",
  "scripts": {
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/handler.js --external:@aws-sdk/* --alias:@=../../src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.906.0",
    "@aws-sdk/client-secrets-manager": "^3.906.0",
    "@aws-sdk/lib-dynamodb": "^3.906.0",
    "nodemailer": "^10.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^6.4.17",
    "esbuild": "^0.28.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
